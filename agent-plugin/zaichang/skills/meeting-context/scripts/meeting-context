#!/bin/sh
set -eu

if [ -z "${ZAICHANG_EDITION:-}" ]; then
  if [ -d "$HOME/Desktop/在场.app" ]; then
    ZAICHANG_EDITION=joe
  else
    ZAICHANG_EDITION=standalone
  fi
fi
export ZAICHANG_EDITION
case "$ZAICHANG_EDITION" in
  standalone) APP="$HOME/Applications/在场.app" ;;
  *) APP="$HOME/Desktop/在场.app" ;;
esac
READER="$APP/Contents/Resources/Runtime/meeting_context.py"

if [ ! -f "$READER" ]; then
  printf '%s\n' '{"status":"unavailable","reason":"在场本机会议读取器尚未安装或应用需要更新。"}'
  exit 2
fi

PYTHON=""
for candidate in \
  "$APP/Contents/Resources/Runtime/Python/bin/python3" \
  "$APP/Contents/Resources/Python/bin/python3" \
  "/usr/local/bin/python3" \
  "/usr/bin/python3" \
  "/opt/homebrew/bin/python3"; do
  if [ -x "$candidate" ]; then
    PYTHON="$candidate"
    break
  fi
done

if [ -z "$PYTHON" ] && command -v python3 >/dev/null 2>&1; then
  PYTHON="$(command -v python3)"
fi

if [ -z "$PYTHON" ]; then
  printf '%s\n' '{"status":"unavailable","reason":"找不到可运行在场本机读取器的 Python 3。"}'
  exit 2
fi

exec "$PYTHON" "$READER" "$@"
